# Copy to .env for local use. NEVER commit the real .env file.
ADMIN_USERNAME=choose-a-username
ADMIN_PASSWORD=choose-a-long-password-min-8-chars

# Optional tuning (defaults shown). Lower these on small servers.
# PROCESS_WIDTH=960
# YOLO_IMGSZ=640
# ALLOWED_MODELS=yolo11n.pt,yolo11s.pt,yolo11m.pt
# MAX_VIDEO_FRAMES=900
# DATA_DIR=./data
# PERSISTENT_STORAGE=true          # set true only if DATA_DIR is on a persistent disk
# RETENTION_DAYS=30
# TURN_URL=turn:your.turn.server:3478  # optional relay for live webcam on strict networks
# TURN_USERNAME=
# TURN_CREDENTIAL=
